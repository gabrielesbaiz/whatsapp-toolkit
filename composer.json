{
    "name": "gabrielesbaiz/whatsapp-toolkit",
    "description": "Click-to-chat links, WhatsApp message formatting, QR codes and Cloud API sending for Laravel.",
    "keywords": [
        "Gabriele Sbaiz",
        "laravel",
        "whatsapp",
        "whatsapp-toolkit",
        "click-to-chat",
        "whatsapp-cloud-api"
    ],
    "homepage": "https://github.com/gabrielesbaiz/whatsapp-toolkit",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriele Sbaiz",
            "email": "gabriele@sbaiz.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "illuminate/contracts": "^11.0||^12.0||^13.0",
        "illuminate/support": "^11.0||^12.0||^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "bacon/bacon-qr-code": "^3.0",
        "larastan/larastan": "^3.1",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^9.0.0||^10.0.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-watch": "^3.0",
        "phpstan/extension-installer": "^1.4"
    },
    "suggest": {
        "bacon/bacon-qr-code": "Required to render click-to-chat QR codes (^3.0).",
        "laravel/nova": "Enables the bundled Nova action and click-to-chat field (^4.0||^5.0)."
    },
    "autoload": {
        "psr-4": {
            "Gabrielesbaiz\\WhatsappToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gabrielesbaiz\\WhatsappToolkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "lint": [
            "@format",
            "@analyse"
        ],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "bench": "@php benchmarks/format.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gabrielesbaiz\\WhatsappToolkit\\WhatsappToolkitServiceProvider"
            ],
            "aliases": {
                "WhatsappToolkit": "Gabrielesbaiz\\WhatsappToolkit\\Facades\\WhatsappToolkit"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
